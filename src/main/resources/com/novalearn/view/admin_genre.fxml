<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20" alignment="CENTER" prefWidth="800" prefHeight="600" styleClass="root"
      stylesheets="@../../styles/styles.css"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.novalearn.controller.AdminGenreController">
    
    <!-- Header -->
    <HBox styleClass="header" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>
        <Label text="NovaLearn" styleClass="logo"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <!-- Left Panel: Table -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="container">
            <Text text="Types de Réclamation" styleClass="title"/>
            
            <TableView fx:id="genreTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="libelleColumn" text="Libellé" prefWidth="200"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="400"/>
                </columns>
            </TableView>
        </VBox>
        
        <!-- Right Panel: Form -->
        <VBox spacing="15" styleClass="container" minWidth="300">
            <Text text="Détails" styleClass="title"/>
            
            <Label text="Libellé"/>
            <TextField fx:id="libelleField"/>
            
            <Label text="Description"/>
            <TextArea fx:id="descriptionField" wrapText="true" prefRowCount="4"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <HBox spacing="10">
                <Button text="Ajouter" onAction="#handleAdd" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Mettre à jour" onAction="#handleUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <HBox spacing="10">
                <Button text="Supprimer" onAction="#handleDelete" styleClass="delete-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Effacer" onAction="#handleClear" styleClass="button,secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </HBox>
</VBox> 