<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.novalearn.controller.ChatController"
      spacing="10"
      styleClass="chat-container">

    <!-- Filtres de recherche -->
    <HBox spacing="10" styleClass="filter-container">
        <TextField fx:id="searchKeyword" promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="filterSender" promptText="Expéditeur"/>
        <DatePicker fx:id="startDate" promptText="Date début"/>
        <DatePicker fx:id="endDate" promptText="Date fin"/>
        <CheckBox fx:id="agentOnlyCheckbox" text="Agent uniquement"/>
    </HBox>

    <!-- Zone de chat -->
    <ScrollPane fx:id="chatScrollPane" VBox.vgrow="ALWAYS" styleClass="chat-scroll">
        <VBox fx:id="chatContainer" spacing="10" styleClass="messages-container">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Zone de saisie -->
    <HBox spacing="10" styleClass="input-container">
        <TextField fx:id="messageInput" HBox.hgrow="ALWAYS" promptText="Tapez votre message..."/>
        <Button fx:id="sendButton" text="Envoyer"/>
    </HBox>

</VBox> 