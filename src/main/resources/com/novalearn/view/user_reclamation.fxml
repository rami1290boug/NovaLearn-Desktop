<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.novalearn.controller.UserReclamationController"
      styleClass="main-container">
    
    <!-- En-tête avec statistiques -->
    <HBox spacing="20" styleClass="stats-container">
        <VBox styleClass="stat-box">
            <Label text="Total" styleClass="stat-label"/>
            <Label fx:id="totalLabel" text="0" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-box">
            <Label text="En attente" styleClass="stat-label"/>
            <Label fx:id="enAttenteLabel" text="0" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-box">
            <Label text="En cours" styleClass="stat-label"/>
            <Label fx:id="enCoursLabel" text="0" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-box">
            <Label text="Résolues" styleClass="stat-label"/>
            <Label fx:id="resoluesLabel" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <!-- Formulaire de réclamation -->
    <VBox spacing="10" styleClass="form-container">
        <TextField fx:id="titreField" promptText="Titre de la réclamation"/>
        <TextArea fx:id="descriptionField" promptText="Description" prefRowCount="3"/>
        <ComboBox fx:id="genreComboBox" promptText="Type de réclamation"/>
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#handleAdd"/>
            <Button text="Modifier" onAction="#handleUpdate"/>
            <Button text="Supprimer" onAction="#handleDelete"/>
            <Button text="Effacer" onAction="#handleClear"/>
        </HBox>
    </VBox>

    <!-- Barre de recherche et filtres -->
    <HBox spacing="10" styleClass="search-container">
        <TextField fx:id="searchField" promptText="Rechercher..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" promptText="Statut"/>
        <ComboBox fx:id="typeFilter" promptText="Type"/>
        <DatePicker fx:id="dateFilter" promptText="Date"/>
        <Button text="Réinitialiser" onAction="#handleResetFilter"/>
    </HBox>

    <!-- Options de tri -->
    <HBox spacing="10" styleClass="sort-container">
        <Label text="Trier par:"/>
        <ComboBox fx:id="sortField"/>
        <ComboBox fx:id="sortOrder"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exporter PDF" onAction="#handleExportPDF"/>
        <Button text="Exporter Excel" onAction="#handleExportExcel"/>
    </HBox>

    <!-- Liste des réclamations -->
    <ListView fx:id="reclamationListView" VBox.vgrow="ALWAYS"/>

    <!-- Boutons d'action -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Nouvelle réclamation" onAction="#handleNewReclamation"/>
        <Button text="Paramètres" fx:id="settingsButton" onAction="#handleSettings"/>
        <Button text="Retour" onAction="#handleBack"/>
    </HBox>

    <stylesheets>
        <URL value="@../styles/styles.css"/>
        <URL value="@../styles/user_reclamation.css"/>
    </stylesheets>
</VBox> 