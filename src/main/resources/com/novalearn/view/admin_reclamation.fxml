<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="20" alignment="CENTER" prefWidth="1000" prefHeight="700" styleClass="root"
      stylesheets="@../../styles/styles.css"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.novalearn.controller.AdminReclamationController">
    
    <!-- Header -->
    <HBox styleClass="header" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>
        <Label text="NovaLearn" styleClass="logo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Retour" styleClass="button,secondary" onAction="#handleBack"/>
    </HBox>

    <!-- Main Content -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <!-- Left Panel: Table -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="container">
            <Text text="Liste des Réclamations" styleClass="title"/>
            
            <TableView fx:id="reclamationTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titreColumn" text="Titre" prefWidth="200"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                    <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="genreColumn" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="dateCreationColumn" text="Date" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
        
        <!-- Right Panel: Form -->
        <VBox spacing="15" styleClass="container" minWidth="300">
            <Text text="Détails" styleClass="title"/>
            
            <Label text="Titre"/>
            <TextField fx:id="titreField"/>
            
            <Label text="Description"/>
            <TextArea fx:id="descriptionField" wrapText="true" prefRowCount="4"/>
            
            <Label text="Type"/>
            <ComboBox fx:id="genreComboBox" maxWidth="Infinity"/>
            
            <Label text="Statut"/>
            <ComboBox fx:id="statutComboBox" maxWidth="Infinity"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <HBox spacing="10">
                <Button text="Gérer les Types" onAction="#handleManageGenres" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <HBox spacing="10">
                <Button text="Mettre à jour" onAction="#handleUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Supprimer" onAction="#handleDelete" styleClass="delete-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <Button text="Effacer" onAction="#handleClear" styleClass="button,secondary" maxWidth="Infinity"/>
        </VBox>
    </HBox>
</VBox> 