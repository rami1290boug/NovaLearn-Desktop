<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.novalearn.controller.AdminReclamationController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Administration des Réclamations" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Gérer les Types" onAction="#handleManageGenres" 
                style="-fx-background-color: #9C27B0; -fx-text-fill: white;"/>
    </HBox>

    <!-- Tableau des réclamations -->
    <TableView fx:id="reclamationTable" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="titreColumn" text="Titre" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250"/>
            <TableColumn fx:id="genreColumn" text="Type" prefWidth="100"/>
            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
            <TableColumn fx:id="dateColumn" text="Date de Création" prefWidth="150"/>
            <TableColumn fx:id="userIdColumn" text="ID Utilisateur" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Formulaire de modification -->
    <TitledPane text="Détails de la réclamation" expanded="false">
        <VBox spacing="10">
            <GridPane hgap="10" vgap="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Label text="Titre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="titreField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="genreComboBox" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextArea fx:id="descriptionField" prefWidth="300" prefHeight="100" wrapText="true" 
                         GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                
                <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="statutComboBox" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Modifier" onAction="#handleUpdateReclamation" 
                        style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
                <Button text="Supprimer" onAction="#handleDeleteReclamation" 
                        style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                <Button text="Actualiser" onAction="#handleRefresh" 
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </TitledPane>
</VBox> 