<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/11" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.novalearn.controller.AccessibilitySettingsController"
      styleClass="settings-container">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Paramètres d'Accessibilité" styleClass="title-label"/>

    <GridPane vgap="15" hgap="10">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Mode Contraste Élevé -->
        <Label text="Mode Contraste Élevé:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <CheckBox fx:id="highContrastCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Synthèse Vocale -->
        <Label text="Synthèse Vocale:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <CheckBox fx:id="textToSpeechCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Saisie Vocale -->
        <Label text="Saisie Vocale:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <CheckBox fx:id="voiceInputCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Suggestions de Mots -->
        <Label text="Suggestions de Mots:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <CheckBox fx:id="wordSuggestionsCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Taille de la Police -->
        <Label text="Taille de la Police:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Slider fx:id="fontSizeSlider" min="12" max="24" value="14" 
                showTickLabels="true" showTickMarks="true" 
                majorTickUnit="2" minorTickCount="1"
                GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <!-- Police -->
        <Label text="Police:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <ComboBox fx:id="fontFamilyComboBox" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <!-- Mise en Évidence des Lignes -->
        <Label text="Mise en Évidence des Lignes:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <CheckBox fx:id="lineHighlightCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <!-- Espacement des Lignes -->
        <Label text="Espacement des Lignes:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <Slider fx:id="lineSpacingSlider" min="1" max="3" value="1" 
                showTickLabels="true" showTickMarks="true" 
                majorTickUnit="1" minorTickCount="0"
                GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Appliquer" onAction="#handleApply" styleClass="apply-button"/>
        <Button text="Annuler" onAction="#handleCancel" styleClass="cancel-button"/>
    </HBox>
</VBox> 